<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="I01_02_BatzenIkasten.MainPage">

    <!--
        ScrollView elementuak edukia mugitzeko aukera ematen du
        pantailaren tamaina edukia baino txikiagoa denean.
    -->
    <ScrollView>

        <!--
            Grid egiturak interfazeko elementuak errenkada eta zutabeetan antolatzen ditu.
        -->
        <Grid
            Padding="30"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnDefinitions="160,180,Auto"
            RowSpacing="18"
            ColumnSpacing="15">

            <!-- Aplikazioaren izenburua -->
            <Label
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Text="Batuketak ikasten"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#A78BFA" />

            <!-- Lehen batugaiaren balioa erakusteko eremua -->
            <Label
                Grid.Row="1"
                Grid.Column="0"
                Text="Lehen batugaia"
                VerticalOptions="Center" />

            <Entry
                x:Name="LehenBatugaiaEntry"
                Grid.Row="1"
                Grid.Column="1"
                IsReadOnly="True" />

            <!-- Batugai berriak ausaz sortzeko botoia -->
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Text="Balio berriak sortu"
                Clicked="OnBalioBerriakClicked" />

            <!-- Bigarren batugaiaren balioa erakusteko eremua -->
            <Label
                Grid.Row="2"
                Grid.Column="0"
                Text="Bigarren batugaia"
                VerticalOptions="Center" />

            <Entry
                x:Name="BigarrenBatugaiaEntry"
                Grid.Row="2"
                Grid.Column="1"
                IsReadOnly="True" />

            <!-- Batugaiak eta erantzunaren atala bereizteko lerroa -->
            <BoxView
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HeightRequest="2"
                Color="White"
                VerticalOptions="Center" />

            <!-- Erabiltzaileak bere erantzuna sartzeko eremua -->
            <Label
                Grid.Row="4"
                Grid.Column="0"
                Text="Sartu zuk uste duzuna"
                VerticalOptions="Center" />

            <Entry
                x:Name="ErantzunaEntry"
                Grid.Row="4"
                Grid.Column="1"
                Keyboard="Numeric" />

            <!-- Erantzunaren balioztapenaren emaitza erakusteko eremua -->
            <Entry
                x:Name="EmaitzaEntry"
                Grid.Row="5"
                Grid.Column="1"
                IsReadOnly="True" />

            <!-- Erabiltzailearen erantzuna zuzena den egiaztatzeko botoia -->
            <Button
                Grid.Row="5"
                Grid.Column="2"
                Text="Balioztatu emaitza"
                Clicked="OnBalioztatuClicked" />

        </Grid>

    </ScrollView>

</ContentPage>