<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="I01_03_OpariLista.MainPage">

    <Grid Padding="30"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="250,*,250"
          ColumnSpacing="30"
          RowSpacing="20">

        <!-- Izenburua -->
        <Label Grid.Row="0"
               Grid.ColumnSpan="3"
               Text="Opariak"
               FontSize="28"
               FontAttributes="Bold" />

        <!-- Opari lista -->
        <ListView x:Name="OpariListView"
                  Grid.Row="1"
                  Grid.Column="0"
                  ItemSelected="OpariListView_ItemSelected" />

        <!-- Aukeratutako opariaren irudia -->
        <VerticalStackLayout Grid.Row="1"
                             Grid.Column="1"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="15">

            <Image x:Name="OpariImage"
                   WidthRequest="300"
                   HeightRequest="250"
                   Aspect="AspectFit" />

            <Label x:Name="AukeratutakoOpariaLabel"
                   FontSize="18"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <!-- Lehen eta bigarren opariak -->
        <VerticalStackLayout Grid.Row="1"
                             Grid.Column="2"
                             Spacing="10">

            <Label Text="Lehen oparia"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label x:Name="LehenOpariaLabel" />

            <Label Text="Bigarren oparia"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,20,0,0" />

            <Label x:Name="BigarrenOpariaLabel" />

        </VerticalStackLayout>

        <!-- Botoiak -->
        <HorizontalStackLayout Grid.Row="2"
                               Grid.ColumnSpan="3"
                               Spacing="15">

            <Button x:Name="AukeratuButton"
                    Text="Aukeratu"
                    Clicked="AukeratuButton_Clicked" />

            <Button Text="Ezabatu"
                    Clicked="EzabatuButton_Clicked" />

            <Button Text="Irten"
                    Clicked="IrtenButton_Clicked" />

        </HorizontalStackLayout>

    </Grid>

</ContentPage>