<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="I01_06_OrdezkariaHautatzea.MainPage"
    Title="Ordezkaria hautatzea">

    <Grid Padding="25"
          RowDefinitions="Auto,*"
          RowSpacing="25">

        <!-- IKASLE BERRIA -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,*,Auto"
              ColumnSpacing="10">

            <Label Grid.Column="0"
                   Text="Ikasle berria"
                   Style="{StaticResource AtalaStyle}"
                   VerticalOptions="Center" />

            <Entry x:Name="IzenaEntry"
                   Grid.Column="1"
                   Placeholder="Izena" />

            <Entry x:Name="AbizenaEntry"
                   Grid.Column="2"
                   Placeholder="Abizena" />

            <Button x:Name="GehituButton"
                    Grid.Column="3"
                    Text="Gehitu"
                    Clicked="GehituButton_Clicked" />

        </Grid>


        <!-- BI LISTAK -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="30">

            <!-- IKASLEAK -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="15">

                <Label Grid.Row="0"
                       Text="Ikasleak"
                       Style="{StaticResource IzenburuaStyle}" />

                <CollectionView x:Name="IkasleakCollection"
                                Grid.Row="1"
                                SelectionMode="Single"
                                SelectionChanged="IkasleakCollection_SelectionChanged">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border Style="{StaticResource IkasleElementuaStyle}"
                                    Margin="0,2">

                                <Label Text="{Binding ErakustekoIzena}"
                                       Style="{StaticResource IkasleTestuaStyle}" />

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>


                <!-- IKASLEEN BOTOIAK -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">

                    <Button x:Name="AusazButton"
                            Grid.Column="0"
                            Text="Ausaz"
                            Clicked="AusazButton_Clicked" />

                    <Button x:Name="IzendatuButton"
                            Grid.Column="1"
                            Text="Izendatu"
                            IsEnabled="False"
                            Clicked="IzendatuButton_Clicked" />

                    <Button x:Name="KenduDenakButton"
                            Grid.Column="2"
                            Text="Kendu denak"
                            Clicked="KenduDenakButton_Clicked" />

                </Grid>

            </Grid>


            <!-- ORDEZKARIAK -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="15">

                <Label Grid.Row="0"
                       Text="Ordezkariak"
                       Style="{StaticResource IzenburuaStyle}" />


                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">

                    <CollectionView x:Name="OrdezkariakCollection"
                                    Grid.Column="0"
                                    SelectionMode="Single"
                                    SelectionChanged="OrdezkariakCollection_SelectionChanged">

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource IkasleElementuaStyle}"
                                        Margin="0,2">

                                    <Label Text="{Binding ErakustekoIzena}"
                                           Style="{StaticResource IkasleTestuaStyle}" />

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>


                    <!-- ORDENA ALDATZEKO BOTOIAK -->
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="10"
                                         VerticalOptions="Center">

                        <Button x:Name="GoraButton"
                                Text="↑"
                                IsEnabled="False"
                                Clicked="GoraButton_Clicked" />

                        <Button x:Name="BeheraButton"
                                Text="↓"
                                IsEnabled="False"
                                Clicked="BeheraButton_Clicked" />

                    </VerticalStackLayout>

                </Grid>


                <!-- ORDEZKARIEN BOTOIAK -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <Button x:Name="KenduButton"
                            Grid.Column="0"
                            Text="Kendu"
                            IsEnabled="False"
                            Clicked="KenduButton_Clicked" />

                    <Button x:Name="HustuButton"
                            Grid.Column="1"
                            Text="Hustu"
                            IsEnabled="False"
                            Clicked="HustuButton_Clicked" />

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</ContentPage>