<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <!-- BOTONES -->

    <Style TargetType="Button">

        <Setter Property="TextColor"
                Value="{StaticResource TextDark}" />

        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="BorderWidth"
                Value="0" />

        <!-- Ertz zuzenak -->
        <Setter Property="CornerRadius"
                Value="0" />

        <Setter Property="Padding"
                Value="14,10" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup x:Name="CommonStates">

                    <VisualState x:Name="Normal" />

                    <VisualState x:Name="Disabled">

                        <VisualState.Setters>

                            <Setter Property="TextColor"
                                    Value="{StaticResource Gray300}" />

                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource DisabledColor}" />

                        </VisualState.Setters>

                    </VisualState>

                    <VisualState x:Name="PointerOver" />

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>

    </Style>


    <!-- ENTRY -->

    <Style TargetType="Entry">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="BackgroundColor"
                Value="{StaticResource PanelBackground}" />

        <Setter Property="PlaceholderColor"
                Value="{StaticResource Gray300}" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

    </Style>


    <!-- LABEL OROKORRA -->

    <Style TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="BackgroundColor"
                Value="Transparent" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

    </Style>


    <!-- IZENBURU NAGUSIA -->

    <Style x:Key="IzenburuaStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="FontSize"
                Value="22" />

        <Setter Property="FontAttributes"
                Value="Bold" />

    </Style>


    <!-- ATALETAKO IZENBURUAK -->

    <Style x:Key="AtalaStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource Primary}" />

        <Setter Property="FontSize"
                Value="18" />

        <Setter Property="FontAttributes"
                Value="Bold" />

    </Style>


    <!-- IKASLEEN TESTUA -->

    <Style x:Key="IkasleTestuaStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="FontSize"
                Value="16" />

        <Setter Property="VerticalTextAlignment"
                Value="Center" />

    </Style>


    <!-- LISTAKO IKASLE ELEMENTUA -->

    <Style x:Key="IkasleElementuaStyle"
           TargetType="Border">

        <Setter Property="BackgroundColor"
                Value="{StaticResource PanelBackground}" />

        <Setter Property="Stroke"
                Value="Transparent" />

        <Setter Property="StrokeThickness"
                Value="0" />

        <Setter Property="Padding"
                Value="10" />

        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup x:Name="CommonStates">

                    <VisualState x:Name="Normal">

                        <VisualState.Setters>

                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource PanelBackground}" />

                        </VisualState.Setters>

                    </VisualState>


                    <VisualState x:Name="Selected">

                        <VisualState.Setters>

                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource SelectedColor}" />

                        </VisualState.Setters>

                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>

    </Style>


    <!-- BORDER -->

    <Style TargetType="Border">

        <Setter Property="Stroke"
                Value="{StaticResource Gray500}" />

        <Setter Property="StrokeShape"
                Value="Rectangle" />

        <Setter Property="StrokeThickness"
                Value="1" />

    </Style>


    <!-- IMAGE BUTTON -->

    <Style TargetType="ImageButton">

        <Setter Property="Opacity"
                Value="1" />

        <Setter Property="BorderColor"
                Value="Transparent" />

        <Setter Property="BorderWidth"
                Value="0" />

        <Setter Property="CornerRadius"
                Value="0" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup x:Name="CommonStates">

                    <VisualState x:Name="Normal" />

                    <VisualState x:Name="Disabled">

                        <VisualState.Setters>

                            <Setter Property="Opacity"
                                    Value="0.5" />

                        </VisualState.Setters>

                    </VisualState>

                    <VisualState x:Name="PointerOver" />

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>

    </Style>


    <!-- CHECKBOX -->

    <Style TargetType="CheckBox">

        <Setter Property="Color"
                Value="{StaticResource Primary}" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

    </Style>


    <!-- PICKER -->

    <Style TargetType="Picker">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="TitleColor"
                Value="{StaticResource Gray300}" />

        <Setter Property="BackgroundColor"
                Value="{StaticResource PanelBackground}" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

    </Style>


    <!-- RADIOBUTTON -->

    <Style TargetType="RadioButton">

        <Setter Property="BackgroundColor"
                Value="Transparent" />

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

    </Style>


    <!-- SWITCH -->

    <Style TargetType="Switch">

        <Setter Property="OnColor"
                Value="{StaticResource Primary}" />

        <Setter Property="ThumbColor"
                Value="{StaticResource White}" />

    </Style>


    <!-- PAGE -->

    <Style TargetType="Page"
           ApplyToDerivedTypes="True">

        <Setter Property="Padding"
                Value="0" />

        <Setter Property="BackgroundColor"
                Value="{StaticResource AppBackground}" />

    </Style>


    <!-- SHELL -->

    <Style TargetType="Shell"
           ApplyToDerivedTypes="True">

        <Setter Property="Shell.BackgroundColor"
                Value="{StaticResource AppBackground}" />

        <Setter Property="Shell.ForegroundColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="Shell.TitleColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="Shell.DisabledColor"
                Value="{StaticResource DisabledColor}" />

        <Setter Property="Shell.UnselectedColor"
                Value="{StaticResource Gray300}" />

        <Setter Property="Shell.NavBarHasShadow"
                Value="False" />

        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{StaticResource AppBackground}" />

        <Setter Property="Shell.TabBarForegroundColor"
                Value="{StaticResource Primary}" />

        <Setter Property="Shell.TabBarTitleColor"
                Value="{StaticResource Primary}" />

        <Setter Property="Shell.TabBarUnselectedColor"
                Value="{StaticResource Gray300}" />

    </Style>


    <!-- NAVIGATION PAGE -->

    <Style TargetType="NavigationPage">

        <Setter Property="BarBackgroundColor"
                Value="{StaticResource AppBackground}" />

        <Setter Property="BarTextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="IconColor"
                Value="{StaticResource TextPrimary}" />

    </Style>


    <!-- TABBED PAGE -->

    <Style TargetType="TabbedPage">

        <Setter Property="BarBackgroundColor"
                Value="{StaticResource AppBackground}" />

        <Setter Property="BarTextColor"
                Value="{StaticResource Primary}" />

        <Setter Property="UnselectedTabColor"
                Value="{StaticResource Gray300}" />

        <Setter Property="SelectedTabColor"
                Value="{StaticResource Primary}" />

    </Style>


</ResourceDictionary>