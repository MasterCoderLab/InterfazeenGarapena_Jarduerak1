<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Aplikazioko kontrolen estilo globalak definitzen dira.
        Estilo hauek App.xaml fitxategitik kargatzen dira eta
        aplikazioaren orri guztietan erabil daitezke.
    -->


    <!-- Botoi guztien oinarrizko estiloa -->
    <Style TargetType="Button">

        <Setter Property="TextColor"
                Value="{StaticResource TextDark}" />

        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="BorderWidth"
                Value="0" />

        <!-- Botoiek ertz zuzenak izango dituzte. -->
        <Setter Property="CornerRadius"
                Value="0" />

        <Setter Property="Padding"
                Value="14,10" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

        <!--
            Botoiaren egoeraren arabera erabiliko den itxura definitzen da.
        -->
        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup x:Name="CommonStates">

                    <!-- Botoiaren egoera normala -->
                    <VisualState x:Name="Normal" />

                    <!-- Botoia desgaituta dagoenean erabiltzen den estiloa -->
                    <VisualState x:Name="Disabled">

                        <VisualState.Setters>

                            <Setter Property="TextColor"
                                    Value="{StaticResource Gray300}" />

                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource DisabledColor}" />

                        </VisualState.Setters>

                    </VisualState>

                    <!-- Saguaren erakuslea botoiaren gainean dagoenean -->
                    <VisualState x:Name="PointerOver" />

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>

    </Style>


    <!-- Testua sartzeko Entry kontrolen estilo globala -->
    <Style TargetType="Entry">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="BackgroundColor"
                Value="{StaticResource PanelBackground}" />

        <Setter Property="PlaceholderColor"
                Value="{StaticResource Gray300}" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

    </Style>


    <!-- Label kontrol guztien oinarrizko estiloa -->
    <Style TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="BackgroundColor"
                Value="Transparent" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

    </Style>


    <!-- Orrietako izenburu nagusietarako estiloa -->
    <Style x:Key="IzenburuaStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="FontSize"
                Value="22" />

        <Setter Property="FontAttributes"
                Value="Bold" />

    </Style>


    <!-- Interfazeko atal desberdinen izenburuetarako estiloa -->
    <Style x:Key="AtalaStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource Primary}" />

        <Setter Property="FontSize"
                Value="18" />

        <Setter Property="FontAttributes"
                Value="Bold" />

    </Style>


    <!-- Ikasleen izenak zerrendetan erakusteko estiloa -->
    <Style x:Key="IkasleTestuaStyle"
           TargetType="Label">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="FontSize"
                Value="16" />

        <Setter Property="VerticalTextAlignment"
                Value="Center" />

    </Style>


    <!-- Ikasleen eta ordezkarien zerrendako elementuen estiloa -->
    <Style x:Key="IkasleElementuaStyle"
           TargetType="Border">

        <Setter Property="BackgroundColor"
                Value="{StaticResource PanelBackground}" />

        <Setter Property="Stroke"
                Value="Transparent" />

        <Setter Property="StrokeThickness"
                Value="0" />

        <Setter Property="Padding"
                Value="10" />

        <!--
            Zerrendako elementuaren egoeraren arabera atzeko kolorea aldatzen da.
        -->
        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup x:Name="CommonStates">

                    <!-- Elementua hautatu gabe dagoenean -->
                    <VisualState x:Name="Normal">

                        <VisualState.Setters>

                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource PanelBackground}" />

                        </VisualState.Setters>

                    </VisualState>

                    <!-- Elementua hautatuta dagoenean -->
                    <VisualState x:Name="Selected">

                        <VisualState.Setters>

                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource SelectedColor}" />

                        </VisualState.Setters>

                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>

    </Style>


    <!-- Border kontrol guztien oinarrizko estiloa -->
    <Style TargetType="Border">

        <Setter Property="Stroke"
                Value="{StaticResource Gray500}" />

        <Setter Property="StrokeShape"
                Value="Rectangle" />

        <Setter Property="StrokeThickness"
                Value="1" />

    </Style>


    <!-- Irudia duen botoi motaren estilo globala -->
    <Style TargetType="ImageButton">

        <Setter Property="Opacity"
                Value="1" />

        <Setter Property="BorderColor"
                Value="Transparent" />

        <Setter Property="BorderWidth"
                Value="0" />

        <Setter Property="CornerRadius"
                Value="0" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

        <!-- ImageButton kontrolaren egoera bisualak definitzen dira. -->
        <Setter Property="VisualStateManager.VisualStateGroups">

            <VisualStateGroupList>

                <VisualStateGroup x:Name="CommonStates">

                    <!-- Egoera normala -->
                    <VisualState x:Name="Normal" />

                    <!-- Kontrola desgaituta dagoenean gardentasuna handitzen da -->
                    <VisualState x:Name="Disabled">

                        <VisualState.Setters>

                            <Setter Property="Opacity"
                                    Value="0.5" />

                        </VisualState.Setters>

                    </VisualState>

                    <!-- Saguaren erakuslea kontrolaren gainean dagoenean -->
                    <VisualState x:Name="PointerOver" />

                </VisualStateGroup>

            </VisualStateGroupList>

        </Setter>

    </Style>


    <!-- CheckBox kontrol guztien estilo globala -->
    <Style TargetType="CheckBox">

        <Setter Property="Color"
                Value="{StaticResource Primary}" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

    </Style>


    <!-- Picker kontrol guztien estilo globala -->
    <Style TargetType="Picker">

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="TitleColor"
                Value="{StaticResource Gray300}" />

        <Setter Property="BackgroundColor"
                Value="{StaticResource PanelBackground}" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

    </Style>


    <!-- RadioButton kontrol guztien estilo globala -->
    <Style TargetType="RadioButton">

        <Setter Property="BackgroundColor"
                Value="Transparent" />

        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="FontFamily"
                Value="OpenSansRegular" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="MinimumHeightRequest"
                Value="44" />

        <Setter Property="MinimumWidthRequest"
                Value="44" />

    </Style>


    <!-- Switch kontrol guztien estilo globala -->
    <Style TargetType="Switch">

        <Setter Property="OnColor"
                Value="{StaticResource Primary}" />

        <Setter Property="ThumbColor"
                Value="{StaticResource White}" />

    </Style>


    <!--
        Page motako orri guztien estilo globala.
        Eratorritako orri motetan ere aplikatzen da.
    -->
    <Style TargetType="Page"
           ApplyToDerivedTypes="True">

        <Setter Property="Padding"
                Value="0" />

        <Setter Property="BackgroundColor"
                Value="{StaticResource AppBackground}" />

    </Style>


    <!--
        Shell kontrolaren estilo globala.
        Nabigazio-barraren eta fitxa-barraren kolore nagusiak definitzen ditu.
    -->
    <Style TargetType="Shell"
           ApplyToDerivedTypes="True">

        <Setter Property="Shell.BackgroundColor"
                Value="{StaticResource AppBackground}" />

        <Setter Property="Shell.ForegroundColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="Shell.TitleColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="Shell.DisabledColor"
                Value="{StaticResource DisabledColor}" />

        <Setter Property="Shell.UnselectedColor"
                Value="{StaticResource Gray300}" />

        <Setter Property="Shell.NavBarHasShadow"
                Value="False" />

        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{StaticResource AppBackground}" />

        <Setter Property="Shell.TabBarForegroundColor"
                Value="{StaticResource Primary}" />

        <Setter Property="Shell.TabBarTitleColor"
                Value="{StaticResource Primary}" />

        <Setter Property="Shell.TabBarUnselectedColor"
                Value="{StaticResource Gray300}" />

    </Style>


    <!-- NavigationPage kontrolaren estilo globala -->
    <Style TargetType="NavigationPage">

        <Setter Property="BarBackgroundColor"
                Value="{StaticResource AppBackground}" />

        <Setter Property="BarTextColor"
                Value="{StaticResource TextPrimary}" />

        <Setter Property="IconColor"
                Value="{StaticResource TextPrimary}" />

    </Style>


    <!-- TabbedPage kontrolaren estilo globala -->
    <Style TargetType="TabbedPage">

        <Setter Property="BarBackgroundColor"
                Value="{StaticResource AppBackground}" />

        <Setter Property="BarTextColor"
                Value="{StaticResource Primary}" />

        <Setter Property="UnselectedTabColor"
                Value="{StaticResource Gray300}" />

        <Setter Property="SelectedTabColor"
                Value="{StaticResource Primary}" />

    </Style>


</ResourceDictionary>