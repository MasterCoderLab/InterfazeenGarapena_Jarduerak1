<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="I01_14_LurpekoParkingKudeaketa.Pantailak.AdministrazioaPage"
             Title="Administrazioa" Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F6FA">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">

        <!-- Pantaila honetako zeregin nagusia plazak taulan ikusi eta kudeatzea da. -->
        <Label Text="Plazen administrazioa" FontSize="24"
               FontAttributes="Bold" TextColor="#15263C" />

        <!-- Zerrenda trinkoa: errenkada asko batera eta korritze independentea. -->
        <Border Grid.Row="1" Padding="10" BackgroundColor="White"
                Stroke="#DCE4EC" StrokeShape="RoundRectangle 12">
            <Grid RowDefinitions="Auto,*" RowSpacing="4">
                <Grid Padding="10,9" ColumnDefinitions="82,86,2*,1.3*" ColumnSpacing="10"
                      BackgroundColor="#EDF3F9">
                    <Label Text="Plaza" FontAttributes="Bold" FontSize="14" TextColor="#334155" />
                    <Label Grid.Column="1" Text="Solairua" FontAttributes="Bold" FontSize="14" TextColor="#334155" />
                    <Label Grid.Column="2" Text="Mota" FontAttributes="Bold" FontSize="14" TextColor="#334155" />
                    <Label Grid.Column="3" Text="Egoera" FontAttributes="Bold" FontSize="14" TextColor="#334155" />
                </Grid>
                <CollectionView x:Name="PlazaZerrenda" Grid.Row="1" SelectionMode="Single"
                                SelectionChanged="PlazaHautatua">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,9" Margin="0,0,0,1" BackgroundColor="#F8FAFD"
                                  ColumnDefinitions="82,86,2*,1.3*" ColumnSpacing="10">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#DCEBFA" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Label Text="{Binding Zenbakia}" FontSize="14" FontAttributes="Bold"
                                       TextColor="#15263C" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Solairua}" FontSize="14"
                                       TextColor="#334155" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding MotaIzena}" FontSize="14"
                                       TextColor="#334155" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding EgoeraIzena}" FontSize="14"
                                       TextColor="#1F5586" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Hautatutako plaza editatzeko formularioa eta ekintzak. -->
        <Border Grid.Row="2" Padding="14" BackgroundColor="White" Stroke="#DCE4EC"
                StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="9">
                <Label Text="Plaza gehitu edo aldatu" FontSize="18"
                       FontAttributes="Bold" TextColor="#15263C" />

                <!-- Zenbakia, solairua, mota eta egoera. -->
                <Grid x:Name="FormularioEremuak" ColumnDefinitions="*,*,*,*"
                      RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Entry x:Name="PlazaZenbakia" Placeholder="P13" FontSize="15"
                           PlaceholderColor="#60738B" />
                    <Entry x:Name="Solairua" Grid.Column="1" Placeholder="-1"
                           Keyboard="Numeric" FontSize="15" PlaceholderColor="#60738B" />
                    <Picker x:Name="PlazaMotaAukera" Grid.Column="2" Title="Mota" FontSize="15">
                        <Picker.Items>
                            <x:String>Autoa</x:String>
                            <x:String>Motorra</x:String>
                            <x:String>Mugikortasun urrikoa</x:String>
                            <x:String>Elektrikoa</x:String>
                        </Picker.Items>
                    </Picker>
                    <Picker x:Name="PlazaEgoeraAukera" Grid.Column="3" Title="Egoera" FontSize="15">
                        <Picker.Items>
                            <x:String>Libre</x:String>
                            <x:String>Okupatuta</x:String>
                            <x:String>Erreserbatuta</x:String>
                            <x:String>Mantentze-lanetan</x:String>
                        </Picker.Items>
                    </Picker>
                </Grid>

                <!-- Operazioak kudeatzaileak baliozkotzen ditu; ezabatzeko baieztapena eskatzen da. -->
                <Grid x:Name="EkintzaBotoiak" ColumnDefinitions="*,*,*,*"
                      RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Button x:Name="GehituBotoia" Text="Gehitu" Clicked="PlazaGehitu" />
                    <Button x:Name="AldatuBotoia" Grid.Column="1" Text="Aldatu" Clicked="PlazaAldatu" />
                    <Button x:Name="MantentzeBotoia" Grid.Column="2" Text="Mantentzera"
                            Clicked="MantentzeraJarri" BackgroundColor="#52677F" TextColor="White" />
                    <Button x:Name="EzabatuBotoia" Grid.Column="3" Text="Ezabatu" Clicked="PlazaEzabatu"
                            BackgroundColor="#8B2A34" TextColor="White" />
                </Grid>
                <Label Text="Okupatutako plazak ezin dira ezabatu edo mantentze-lanetan jarri."
                       FontSize="13" TextColor="#52677F" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
