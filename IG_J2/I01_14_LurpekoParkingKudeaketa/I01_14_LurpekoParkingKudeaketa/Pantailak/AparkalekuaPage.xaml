<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:testuak="clr-namespace:I01_14_LurpekoParkingKudeaketa.Resources.Strings"
             x:Class="I01_14_LurpekoParkingKudeaketa.Pantailak.AparkalekuaPage"
             Title="{x:Static testuak:AppResources.ParkingTab}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F6FA">
    <Grid x:Name="DiseinuNagusia" Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">

        <!-- Pantailaren izenburua eta iragazitako plazen kopurua. -->
        <VerticalStackLayout Grid.Row="0" Spacing="3">
            <Label x:Name="Izenburua" Text="{x:Static testuak:AppResources.ParkingStatusTitle}"
                   FontSize="25" FontAttributes="Bold" TextColor="#15263C" />
            <Label x:Name="PlazaKopurua" Text="{x:Static testuak:AppResources.LoadingSpaces}"
                   FontSize="14" TextColor="#52677F" />
        </VerticalStackLayout>

        <!-- Solairuaren, egoeraren eta motaren araberako iragazkiak. -->
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Grid x:Name="IragazkiSarea" RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <VerticalStackLayout x:Name="SolairuIragazkiaMultzoa" Grid.Column="0" Spacing="2">
                    <Label Text="{x:Static testuak:AppResources.Floor}" FontSize="13" TextColor="#52677F" />
                    <Picker x:Name="SolairuIragazkia" Title="{x:Static testuak:AppResources.Floor}"
                            TitleColor="#52677F" TextColor="#15263C" FontSize="15"
                            SelectedIndexChanged="IragazkiakAldatuta" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="EgoeraIragazkiaMultzoa" Grid.Column="1" Spacing="2">
                    <Label Text="{x:Static testuak:AppResources.Status}" FontSize="13" TextColor="#52677F" />
                    <Picker x:Name="EgoeraIragazkia" Title="{x:Static testuak:AppResources.Status}"
                            TitleColor="#52677F" TextColor="#15263C" FontSize="15"
                            SelectedIndexChanged="IragazkiakAldatuta" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="MotaIragazkiaMultzoa" Grid.Column="2" Spacing="2">
                    <Label Text="{x:Static testuak:AppResources.Type}" FontSize="13" TextColor="#52677F" />
                    <Picker x:Name="MotaIragazkia" Title="{x:Static testuak:AppResources.Type}"
                            TitleColor="#52677F" TextColor="#15263C" FontSize="15"
                            SelectedIndexChanged="IragazkiakAldatuta" />
                </VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{x:Static testuak:AppResources.OnlyFree}" VerticalOptions="Center"
                       FontSize="14" TextColor="#15263C" />
                <Switch x:Name="LibreakBakarrik" Grid.Column="1"
                        Toggled="LibreakBakarrikAldatuta" />
            </Grid>
        </VerticalStackLayout>

        <!-- Tabletetan zerrenda eta fitxa alboz albo; mugikorretan bata bestearen azpian. -->
        <Grid x:Name="EmaitzaSarea" Grid.Row="2" ColumnDefinitions="1.5*,1*"
              RowDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="12">

            <!-- Plaza asko modu trinkoan ikusteko taula birtualizatua. -->
            <Border x:Name="PlazaZerrendaPanela" Grid.Row="0" Grid.Column="0"
                    Padding="10" BackgroundColor="White" Stroke="#DCE4EC"
                    StrokeShape="RoundRectangle 12">
                <Grid RowDefinitions="Auto,*" RowSpacing="5">
                    <Grid Padding="8,8" ColumnDefinitions="62,68,*,100" ColumnSpacing="8"
                          BackgroundColor="#EDF3F9">
                        <Label Text="Plaza" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                        <Label Grid.Column="1" Text="Solairua" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                        <Label Grid.Column="2" Text="Mota" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                        <Label Grid.Column="3" Text="Egoera" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                    </Grid>
                    <CollectionView x:Name="PlazaZerrenda" Grid.Row="1"
                                    SelectionMode="Single" SelectionChanged="PlazaHautatua"
                                    EmptyView="{x:Static testuak:AppResources.NoSpaces}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,10" Margin="0,0,0,1" BackgroundColor="#F8FAFD"
                                      ColumnDefinitions="62,68,*,100" ColumnSpacing="8">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#DCEBFA" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label Text="{Binding Zenbakia}" FontSize="14" FontAttributes="Bold"
                                           TextColor="#15263C" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Solairua}" FontSize="14"
                                           TextColor="#334155" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding MotaIzena}" FontSize="14"
                                           TextColor="#334155" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding EgoeraIzena}" FontSize="13"
                                           TextColor="#1F5586" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <!-- Hautatutako plazaren fitxa eta okupatzen duen ibilgailua. -->
            <Border x:Name="PlazaXehetasunPanela" Grid.Row="0" Grid.Column="1"
                    Padding="16" BackgroundColor="White" Stroke="#DCE4EC"
                    StrokeShape="RoundRectangle 12" VerticalOptions="Fill">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static testuak:AppResources.SpaceDetailsTitle}"
                           FontSize="18" FontAttributes="Bold" TextColor="#15263C" />
                    <Label x:Name="PlazaXehetasunak" Text="{x:Static testuak:AppResources.SelectSpace}"
                           TextColor="#334155" FontSize="15" />
                    <Label x:Name="IbilgailuXehetasunak" Text=""
                           TextColor="#334155" FontSize="15" />
                    <Button x:Name="IbilgailuaIkusiBotoia" Text="{x:Static testuak:AppResources.ShowVehicle}"
                            Clicked="IbilgailuaIkusi" IsEnabled="False"
                            BackgroundColor="#1F5586" TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
