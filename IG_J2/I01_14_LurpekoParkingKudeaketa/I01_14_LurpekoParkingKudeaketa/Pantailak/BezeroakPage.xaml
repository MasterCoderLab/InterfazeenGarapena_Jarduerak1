<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="I01_14_LurpekoParkingKudeaketa.Pantailak.BezeroakPage"
             Title="Bezeroak" Shell.NavBarIsVisible="False" BackgroundColor="#F3F6FA">
    <Grid x:Name="DiseinuNagusia" Padding="18"
          RowDefinitions="Auto,*,Auto" ColumnDefinitions="0.9*,1.4*"
          RowSpacing="12" ColumnSpacing="12">
        <Label x:Name="Izenburua" Grid.ColumnSpan="2" Text="Bezeroak"
               FontSize="25" FontAttributes="Bold" TextColor="#15263C" />

        <!-- Bezeroen zerrenda trinkoa; hautapena eskuineko fitxan erakusten da. -->
        <Border x:Name="BezeroZerrendaPanela" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                Padding="10" BackgroundColor="White" Stroke="#DCE4EC"
                StrokeShape="RoundRectangle 12">
            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <Grid Padding="8,9" ColumnDefinitions="*,116" ColumnSpacing="8"
                      BackgroundColor="#EDF3F9">
                    <Label Text="Bezeroa" FontSize="14" FontAttributes="Bold" TextColor="#334155" />
                    <Label Grid.Column="1" Text="NAN" FontSize="14"
                           FontAttributes="Bold" TextColor="#334155"
                           HorizontalTextAlignment="End" />
                </Grid>
                <CollectionView x:Name="BezeroZerrenda" Grid.Row="1" SelectionMode="Single"
                                SelectionChanged="BezeroaHautatua">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,12" Margin="0,0,0,1" BackgroundColor="#F8FAFD"
                                  ColumnDefinitions="*,116" ColumnSpacing="8">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#DCEBFA" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Label Text="{Binding IzenOsoa}" FontSize="14" FontAttributes="Bold"
                                       TextColor="#15263C" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Nan}" FontSize="13"
                                       TextColor="#52677F" VerticalOptions="Center"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Bezeroaren fitxa eta bere ibilgailuak tabletetan eskuinean kokatzen dira. -->
        <Grid x:Name="XehetasunSarea" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
              ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="12">
            <Border x:Name="BezeroFitxa" Grid.Row="0" Padding="16"
                    BackgroundColor="White" Stroke="#DCE4EC"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Bezeroaren fitxa" FontSize="18"
                           FontAttributes="Bold" TextColor="#15263C" />
                    <Label x:Name="BezeroXehetasunak" Text="Hautatu bezero bat."
                           TextColor="#334155" FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <!-- Ibilgailuaren gaineko klik bikoitzak ibilgailuen pantaila irekitzen du. -->
            <Border x:Name="IbilgailuPanela" Grid.Row="1" Padding="14"
                    BackgroundColor="White" Stroke="#DCE4EC"
                    StrokeShape="RoundRectangle 12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <Label Text="Bezeroaren ibilgailuak" FontSize="18"
                           FontAttributes="Bold" TextColor="#15263C" />
                    <Label Grid.Row="1" Text="Sakatu bi aldiz ibilgailu bat irekitzeko."
                           TextColor="#52677F" FontSize="13" />
                    <CollectionView x:Name="IbilgailuZerrenda" Grid.Row="2"
                                    SelectionMode="None" MaximumHeightRequest="200"
                                    EmptyView="Ez dago ibilgailurik.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="5,10" ColumnDefinitions="105,*" ColumnSpacing="10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="2"
                                                              CommandParameter="{Binding .}"
                                                              Tapped="IbilgailuaBiAldizSakatuta" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Matrikula}" FontSize="14"
                                           FontAttributes="Bold" TextColor="#15263C"
                                           VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding Marka}" FontSize="14" TextColor="#334155" />
                                        <Label Text="{Binding Modeloa}" FontSize="14" TextColor="#52677F" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
