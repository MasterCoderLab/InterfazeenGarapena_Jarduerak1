<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:testuak="clr-namespace:I01_14_LurpekoParkingKudeaketa.Resources.Strings"
             x:Class="I01_14_LurpekoParkingKudeaketa.Pantailak.IbilgailuakPage"
             Title="{x:Static testuak:AppResources.VehiclesTab}"
             Shell.NavBarIsVisible="False" BackgroundColor="#F3F6FA">
    <Grid x:Name="DiseinuNagusia" Padding="18"
          RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Label x:Name="Izenburua" Text="{x:Static testuak:AppResources.VehicleListTitle}"
               FontSize="25" FontAttributes="Bold" TextColor="#15263C" />

        <!-- Matrikula, marka edo jabearen arabera bilatzeko eremua. -->
        <SearchBar x:Name="Bilaketa" Grid.Row="1"
                   Placeholder="{x:Static testuak:AppResources.SearchPlaceholder}"
                   TextChanged="BilaketaAldatuta" FontSize="16"
                   TextColor="#15263C" PlaceholderColor="#52677F" BackgroundColor="White" />

        <!-- Ibilgailuen taula trinkoa, erregistro asko batera arakatzeko. -->
        <Border Grid.Row="2" Padding="10" BackgroundColor="White"
                Stroke="#DCE4EC" StrokeShape="RoundRectangle 12">
            <Grid RowDefinitions="Auto,*" RowSpacing="4">
                <Grid Padding="8,8" ColumnDefinitions="105,2*,1.3*" ColumnSpacing="10"
                      BackgroundColor="#EDF3F9">
                    <Label Text="Matrikula" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                    <Label Grid.Column="1" Text="Ibilgailua" FontSize="13"
                           FontAttributes="Bold" TextColor="#334155" />
                    <Label Grid.Column="2" Text="Jabea" FontSize="13"
                           FontAttributes="Bold" TextColor="#334155" />
                </Grid>
                <CollectionView x:Name="IbilgailuZerrenda" Grid.Row="1"
                                SelectionMode="Single" SelectionChanged="IbilgailuaHautatua"
                                EmptyView="{x:Static testuak:AppResources.NoVehicles}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,7" Margin="0,0,0,1" BackgroundColor="#F8FAFD"
                                  ColumnDefinitions="105,2*,1.3*" ColumnSpacing="10">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#DCEBFA" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Label Text="{Binding Matrikula}" FontSize="14" FontAttributes="Bold"
                                       TextColor="#15263C" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="{Binding Marka}" FontSize="14" TextColor="#15263C" />
                                    <Label Text="{Binding Modeloa}" FontSize="12" TextColor="#52677F" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Jabea.IzenOsoa}" FontSize="14"
                                       TextColor="#334155" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Ibilgailuaren fitxa eta historikoa tabletetan alboz albo agertzen dira. -->
        <Grid x:Name="XehetasunSarea" Grid.Row="3"
              ColumnDefinitions="0.85*,1.5*" RowDefinitions="Auto,Auto"
              ColumnSpacing="10" RowSpacing="10">
            <Border x:Name="IbilgailuFitxa" Grid.Row="0" Grid.Column="0"
                    Padding="14" BackgroundColor="White"
                    Stroke="#DCE4EC" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static testuak:AppResources.VehicleCardTitle}"
                           FontSize="18" FontAttributes="Bold" TextColor="#15263C" />
                    <Label x:Name="IbilgailuXehetasunak"
                           Text="{x:Static testuak:AppResources.SelectVehicle}"
                           FontSize="14" TextColor="#334155" />
                </VerticalStackLayout>
            </Border>

            <!-- Sarrera, irteera, plaza eta ordaindutako zenbatekoa taula batean. -->
            <Border x:Name="HistoriaPanela" Grid.Row="0" Grid.Column="1"
                    Padding="14" BackgroundColor="White"
                    Stroke="#DCE4EC" StrokeShape="RoundRectangle 10">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <Label Text="{x:Static testuak:AppResources.HistoryTitle}"
                           FontSize="18" FontAttributes="Bold" TextColor="#15263C" />
                    <Grid x:Name="HistoriaGoiburua" Grid.Row="1"
                          ColumnDefinitions="58,*,*,90" ColumnSpacing="8" IsVisible="False">
                        <Label Text="Plaza" FontSize="13" FontAttributes="Bold" TextColor="#52677F" />
                        <Label Grid.Column="1" Text="Sarrera" FontSize="13"
                               FontAttributes="Bold" TextColor="#52677F" />
                        <Label Grid.Column="2" Text="Irteera" FontSize="13"
                               FontAttributes="Bold" TextColor="#52677F" />
                        <Label Grid.Column="3" Text="€" FontSize="13" FontAttributes="Bold"
                               TextColor="#52677F" HorizontalTextAlignment="End" />
                    </Grid>
                    <CollectionView x:Name="HistoriaZerrenda" Grid.Row="2"
                                    HeightRequest="42" SelectionMode="None"
                                    EmptyView="{x:Static testuak:AppResources.NoHistory}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="3,6" ColumnDefinitions="58,*,*,90" ColumnSpacing="8">
                                    <Label Text="{Binding Plaza}" FontSize="13"
                                           TextColor="#15263C" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Sarrera}" FontSize="13"
                                           TextColor="#334155" />
                                    <Label Grid.Column="2" Text="{Binding Irteera}" FontSize="13"
                                           TextColor="#334155" />
                                    <Label Grid.Column="3" Text="{Binding Zenbatekoa}" FontSize="13"
                                           TextColor="#334155" VerticalOptions="Center"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
